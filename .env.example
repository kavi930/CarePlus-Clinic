# =============================================================================
# APEX HEALTH CLINIC — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or production credentials to source control.
# If any integration credential is left blank, the application automatically
# operates in safe simulation/fallback mode.
# =============================================================================

# Application Base URL (Default: http://localhost:3000)
APP_BASE_URL=http://localhost:3000

# Session Encryption Secret
SESSION_SECRET=your_random_32_character_session_secret_placeholder

# Clinic Timezone (Default: Asia/Kolkata)
CLINIC_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR INTEGRATION (OAuth or Service Account)
# -----------------------------------------------------------------------------
# When omitted, calendar events are recorded as "Simulated" in database logs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
GOOGLE_CALENDAR_ID=

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS PLATFORM / CLOUD API
# -----------------------------------------------------------------------------
# When omitted, notifications are logged in the simulation queue.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=apex_health_verify_token
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# AI ASSISTANT / CHATBOT PROVIDER
# -----------------------------------------------------------------------------
# When omitted, the chatbot uses the clinical rule-based safety engine.
AI_API_KEY=

# -----------------------------------------------------------------------------
# WEBHOOK RELAY (e.g. n8n or Make.com)
# -----------------------------------------------------------------------------
AUTOMATION_WEBHOOK_URL=https://your-n8n-instance.example/webhook/apex-health-clinic
